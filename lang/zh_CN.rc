IDD_FIND_DIALOG DIALOGEX 0, 0, 200, 110
CAPTION "查找和替换"
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION | WS_VISIBLE
FONT 9, "Segoe UI", 400, 0, 1
{
    LTEXT "查找内容(&F):", -1, 5, 7, 50, 8
    EDITTEXT IDC_FIND_EDIT, 55, 5, 135, 14, ES_AUTOHSCROLL
    LTEXT "替换为(&P):", IDC_REPLACE_LABEL, 5, 25, 50, 8
    EDITTEXT IDC_REPLACE_EDIT, 55, 23, 135, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "区分大小写(&C)", IDC_FIND_CASE, 10, 42, 160, 10
    AUTOCHECKBOX "全字匹配(&W)", IDC_FIND_WORD, 10, 54, 160, 10
    AUTOCHECKBOX "正则表达式(&E)", IDC_FIND_REGEX, 10, 66, 160, 10
    DEFPUSHBUTTON "查找下一个(F3)", IDC_FIND_NEXT, 120, 85, 70, 14
    PUSHBUTTON "替换(&R)", IDC_REPLACE_BTN, 65, 85, 50, 14
    PUSHBUTTON "全部替换(&A)", IDC_REPLACE_ALL_BTN, 5, 85, 55, 14
}

IDD_GOTO_DIALOG DIALOGEX 0, 0, 150, 60
CAPTION "转到行"
