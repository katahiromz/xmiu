// RT_DIALOG

IDD_FIND_DIALOG DIALOGEX 0, 0, 240, 110
CAPTION "Rechercher et remplacer"
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION | WS_VISIBLE
FONT 9, "Segoe UI", 400, 0, 1
{
    LTEXT "Rechercher(&F) :", -1, 5, 7, 65, 8
    EDITTEXT IDC_FIND_EDIT, 75, 5, 155, 14, ES_AUTOHSCROLL
    LTEXT "Remplacer par(&P) :", IDC_REPLACE_LABEL, 5, 25, 65, 8
    EDITTEXT IDC_REPLACE_EDIT, 75, 23, 155, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX "Respecter la casse(&C)", IDC_FIND_CASE, 10, 42, 220, 10
    AUTOCHECKBOX "Mot entier(&W)", IDC_FIND_WORD, 10, 54, 220, 10
    AUTOCHECKBOX "Expression régulière(&E)", IDC_FIND_REGEX, 10, 66, 220, 10
    DEFPUSHBUTTON "Suivant(F3)", IDC_FIND_NEXT, 145, 85, 90, 14
    PUSHBUTTON "Remplacer(&R)", IDC_REPLACE_BTN, 80, 85, 60, 14
    PUSHBUTTON "Remplacer tout(&A)", IDC_REPLACE_ALL_BTN, 5, 85, 70, 14
}

IDD_GOTO_DIALOG DIALOGEX 0, 0, 180, 60
CAPTION "Aller à la ligne"
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "Segoe UI", 400, 0, 1
{
    LTEXT "Numéro de ligne (1 - %d)(&L):", IDC_GOTO_LABEL, 10, 10, 160, 8
    EDITTEXT IDC_GOTO_EDIT, 10, 22, 160, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 65, 40, 50, 14
    PUSHBUTTON "Annuler", IDCANCEL, 120, 40, 50, 14
}

